# ==============================================================================
# AI-Driven Fresher Job & Resume Platform — Environment Configuration
# ==============================================================================

# Application Environment (development | staging | production)
APP_ENV=development
APP_NAME="HireMe AI"
DEBUG=true

# Database Configuration
# Production uses PostgreSQL async driver:
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_jobs_db
# SQLite fallback (used automatically if PostgreSQL is unreachable):
# DATABASE_URL=sqlite+aiosqlite:///./ai_job_platform.db

# LLM Providers Configuration
LLM_PROVIDER=groq
# Primary Groq API Key (get from https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODELS=["openai/gpt-oss-20b", "qwen/qwen3.8-27b"]

# Gemini API Key (Swappable fallback provider)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Job Sources — Aggregator API Keys & Toggles
# Adzuna (https://developer.adzuna.com/)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ENABLE_ADZUNA=false

# Jooble (https://jooble.org/api/about)
JOOBLE_KEY=
ENABLE_JOOBLE=false

# JSearch via RapidAPI (https://rapidapi.com/letscrape-6bRBa3qguO5/api/jsearch)
RAPIDAPI_KEY=
ENABLE_JSEARCH=false

# Careerjet (https://www.careerjet.com/partners/api/)
CAREERJET_AFFID=
ENABLE_CAREERJET=false

# Direct ATS Public Boards (Driven by app/services/job_sources/companies.yaml)
ENABLE_GREENHOUSE=true
ENABLE_LEVER=true
ENABLE_ASHBY=true

# Free / Open Public Remote Job Boards
ENABLE_ARBEITNOW=true
ENABLE_THEMUSE=true
ENABLE_HIMALAYAS=true
ENABLE_REMOTIVE=true

# Fresher Filtering & Scheduling
MIN_FRESHER_SCORE=60.0
JOB_SYNC_INTERVAL_HOURS=6
JOB_MAX_AGE_DAYS=30
JOB_INACTIVE_DAYS=14
